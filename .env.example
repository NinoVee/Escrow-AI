# EscrowFlow environment. Copy to .env and fill in. Never commit real secrets.
# Generate secrets with:  openssl rand -base64 48   (FIELD_ENCRYPTION_KEY: openssl rand -base64 32)

# --- Core ---------------------------------------------------------------
DATABASE_URL="postgresql://escrowflow:escrowflow@localhost:5432/escrowflow?schema=public"
# Direct (non-pooled) URL for migrations when DATABASE_URL points at a connection pooler (e.g. on Vercel)
DIRECT_DATABASE_URL=""
# Max DB connections per server instance (default 10; 3 on Vercel)
DB_POOL_MAX=""
REDIS_URL="redis://localhost:6379"
# Public base URL. On Vercel it may be left empty (the deployment URL is used).
APP_URL="http://localhost:3000"

# Better Auth session/cookie secret (>= 32 chars)
BETTER_AUTH_SECRET=""
# AES-256-GCM key for bank details and other sensitive fields: 32 bytes, base64
FIELD_ENCRYPTION_KEY=""
# HMAC key for short-lived local download links (>= 32 chars)
DOWNLOAD_SIGNING_SECRET=""

# --- Document storage (private) ----------------------------------------
# "local" writes to STORAGE_LOCAL_DIR; "s3" uses any S3-compatible store (MinIO in docker-compose)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-west-2"
S3_BUCKET="escrowflow-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
MAX_UPLOAD_MB="25"
DOWNLOAD_LINK_TTL_SECONDS="60"

# Malware scanning: "demo" (EICAR test string only - NOT real protection), "clamav", or "none" (files stay quarantined)
MALWARE_SCANNER="demo"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"

# --- AI (server-side only) ----------------------------------------------
# AI_PROVIDER: "auto" uses Anthropic when ANTHROPIC_API_KEY is set, else the labeled demo adapter
AI_PROVIDER="auto"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
ANTHROPIC_EFFORT="medium"
# OCR for scanned PDFs/images: "anthropic" (Claude vision/PDF input) or "none"
OCR_PROVIDER="anthropic"

# --- Email (external sending is OFF unless both switches are on) ---------
EXTERNAL_SEND_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# --- Webhook signing secrets (per provider) ------------------------------
ESIGN_WEBHOOK_SECRET=""
RECORDING_WEBHOOK_SECRET=""
TITLE_WEBHOOK_SECRET=""

# --- Title / property data providers (leave blank until you have an
#     agreement that includes API access and official documentation) ------
ATTOM_API_KEY=""
DATATREE_CLIENT_ID=""
DATATREE_CLIENT_SECRET=""
QUALIA_API_KEY=""

# --- Background jobs ------------------------------------------------------
# JOBS_MODE: "queue" (BullMQ + Redis; run `npm run worker`), "inline" (run in the web process
# before responding) or "deferred" (run right after the response; serverless hosts).
# Default: deferred on Vercel, queue when REDIS_URL is set, inline otherwise and in tests.
JOBS_MODE=""
# Bearer token for the scheduled sweep at /api/cron/jobs (Vercel Cron). openssl rand -hex 32
CRON_SECRET=""
# Vercel builds: apply migrations during the build (default: production builds only)
MIGRATE_ON_BUILD=""
# Vercel builds: load FICTIONAL demo data once (published passwords; use only with Deployment Protection)
SEED_DEMO_DATA=""
WORKER_CONCURRENCY="4"

# Sign-in / TOTP attempts per IP per 5 minutes (raise only for automated local testing)
AUTH_SIGNIN_MAX_ATTEMPTS="10"

LOG_LEVEL="info"
